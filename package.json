{
  "name": "ivertim-corpus",
  "version": "0.1.0",
  "private": true,
  "description": "Samostalni IVERTIM alat za analizu i obradu Corpus S3D projekata",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:s3d": "node --experimental-strip-types scripts/audit-s3d.ts",
    "audit:s3d:machining": "node --experimental-strip-types scripts/audit-s3d-machining.ts",
    "audit:s3d:c6dat": "node --experimental-strip-types scripts/audit-s3d-c6dat.ts",
    "audit:s3d:macros": "node --experimental-strip-types scripts/audit-s3d-macros.ts",
    "audit:s3d:saw": "node --experimental-strip-types scripts/audit-s3d-saw-semantics.ts",
    "audit:e3d": "node --experimental-strip-types scripts/audit-e3d-library.ts",
    "audit:cmk": "node --experimental-strip-types scripts/audit-cmk-library.ts",
    "audit:cmk:holes": "node --experimental-strip-types scripts/audit-cmk-hole-correlation.ts",
    "audit:cmk:raster": "node --experimental-strip-types scripts/audit-cmk-raster-semantics.ts",
    "audit:cmk:saw": "node --experimental-strip-types scripts/audit-cmk-saw-semantics.ts",
    "audit:materials": "node --experimental-strip-types scripts/audit-material-library.ts",
    "audit:holes": "node --experimental-strip-types scripts/audit-hole-planes.ts",
    "audit:e3d:joints": "node --experimental-strip-types scripts/audit-e3d-joint-geometry.ts",
    "audit:joints": "node --experimental-strip-types scripts/audit-e3d-joint-geometry.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
